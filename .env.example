# Dead Reckoning — environment configuration
# Copy to .env and adjust for your local inference endpoint.
# Any OpenAI-compatible endpoint works: Ollama, LM Studio, vLLM, etc.

# OpenAI-compatible base URL. For Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1
# API key (Ollama accepts any non-empty string, e.g. "ollama")
OPENAI_API_KEY=ollama
# Model name served by the endpoint
OPENAI_MODEL=llama3.2

# gRPC server listen port
GRPC_PORT=50051
# Express + WebSocket bridge port (browser talks to this)
BRIDGE_PORT=3001
# Token journal TTL: how long a session survives without activity before eviction
JOURNAL_TTL_MS=600000
JOURNAL_DB=.journal.db
