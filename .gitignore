# ============================================================
# Dead Reckoning — .gitignore
# Everything below is NOT required (and in most cases must not
# be) in the GitHub repository.
# ============================================================

# ---------- Dependencies ----------
node_modules/
**/node_modules/

# ---------- Build output ----------
dist/
**/dist/
*.tsbuildinfo

# ---------- Environment / secrets ----------
# .env contains real API keys and local endpoint config — never commit it.
.env
.env.*
!.env.example

# ---------- Generated proto types (regenerate with `npm run proto:gen`) ----------
# Committed generated types are convenient for cloning; if you prefer to
# regenerate, uncomment the two lines below.
# server/generated/
# client/generated/

# ---------- Benchmark output ----------
# results.md is generated by `npm run bench`; keep the committed copy in sync
# or regenerate it. Ignore stray per-run outputs.
benchmark/results.md.*
*.bench.log

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editor / OS noise ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# ---------- Test / coverage / temp ----------
coverage/
.nyc_output/
*.test.js
*.spec.js
.tmp/
*.tmp.ts
*.tmp.tsx

# ---------- Local tooling caches ----------
.npm-cache/
.cache/
.turbo/
.eslintcache

# ---------- Misc ----------
*.tgz
*.tar.gz
.DS_Store

docs/